{
    "name": "liberusoftware/ecommerce-laravel",
    "type": "project",
    "description": "Liberu Ecommerce — an open-source e-commerce platform built on Laravel, Filament and Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "bezhansalleh/filament-shield": "^4.3.1",
        "biostate/filament-menu-builder": "^5.1.0",
        "bursteri/socialstream": "^7.0.0",
        "filament/filament": "^5.11.0",
        "filament/spatie-laravel-settings-plugin": "^5.11.0",
        "guzzlehttp/guzzle": "^7.16.1",
        "laravel/cashier": "^16.9.0",
        "laravel/framework": "^13.38.0",
        "laravel/horizon": "^5.50.1",
        "laravel/jetstream": "^5.5.3",
        "laravel/octane": "^2.22.0",
        "laravel/reverb": "^1.12.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "liberusoftware/composer-installer": "^1.1",
        "liberusoftware/module-manager": "^1.4.3",
        "liberusoftware/users-roles": "^1.0",
        "livewire/livewire": "^4.4.8",
        "orangehill/iseed": "^3.8.1",
        "php": "^8.5",
        "spatie/laravel-menu": "^4.2.2",
        "spatie/laravel-permission": "^8.3.2",
        "spatie/laravel-query-builder": "^7.3.7",
        "srmklive/paypal": "^3.2.0",
        "webonyx/graphql-php": "^15.39.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.2",
        "fakerphp/faker": "^1.24.1",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.4.3",
        "rector/rector": "^2.8.1",
        "spatie/laravel-ignition": "^2.12.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan test"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "liberusoftware/composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-posix": "1.0.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "modules/users-roles",
            "options": {
                "symlink": false
            }
        }
    ]
}
