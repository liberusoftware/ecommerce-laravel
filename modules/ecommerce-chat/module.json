{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "ecommerce-chat",
  "display_name": "Chat",
  "description": "Customer chat and conversation management",
  "version": "1.0.0",
  "category": "capability",
  "provider": "Liberu\\Ecommerce\\Chat\\ServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-manager": "^1.0"
    }
  },
  "capabilities": [
    "ecommerce.chat.conversations",
    "ecommerce.chat.analytics"
  ],
  "default_enabled": true,
  "features": [
    "Chat Conversations",
    "Chat Messages",
    "Chat Analytics"
  ]
}