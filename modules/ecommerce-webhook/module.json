{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "ecommerce-webhook",
  "display_name": "Webhook",
  "description": "Webhook endpoint and delivery management",
  "version": "1.0.0",
  "category": "capability",
  "provider": "Liberu\\Ecommerce\\Webhook\\ServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-manager": "^1.0"
    }
  },
  "capabilities": [
    "ecommerce.webhook.endpoints",
    "ecommerce.webhook.deliveries"
  ],
  "default_enabled": true,
  "features": [
    "Webhook Endpoints",
    "Webhook Deliveries"
  ]
}